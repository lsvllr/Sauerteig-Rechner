<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push-Token der Live-Aktivität (Weckdienst). Beim Export für TestFlight setzt Xcode „production“. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sicherung in der privaten CloudKit-Datenbank des Nutzers (App/Sicherung.swift). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.eliasvollrath.sauerteig</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
